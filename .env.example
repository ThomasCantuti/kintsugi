# Empty = local dev deployment (atlas local); set the Atlas Sandbox URI for the real thing
MONGODB_URI=
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Any OpenAI-compatible endpoint: OpenRouter (default) or NVIDIA (https://integrate.api.nvidia.com/v1)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
AGENT_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free
SUPERVISOR_MODEL=anthropic/claude-sonnet-5.5
FRONTIER_MODEL=anthropic/claude-sonnet-5.5
# Embeddings: Voyage. Key from Atlas (AI Models → model API key) → https://ai.mongodb.com/v1,
# or from dash.voyageai.com → https://api.voyageai.com/v1. Empty key = Nemotron embed via LLM_BASE_URL.
EMBED_API_KEY=
EMBED_BASE_URL=https://ai.mongodb.com/v1
EMBED_MODEL=voyage-4-lite
EXA_API_KEY=
BUDGET_USD=5
RAINDROP_WRITE_KEY=
